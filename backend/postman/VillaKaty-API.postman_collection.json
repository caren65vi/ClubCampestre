{
  "info": {
    "name": "Villa Katy - API REST del proyecto",
    "description": "Pruebas de la API del Club Campestre Villa Katy (GA7-220501096-AA5-EV03 y AA5-EV04).\nAntes de ejecutar: encender SQL Server y el backend (mvnw spring-boot:run).\nConfigure las variables usuario y contrasena con un usuario del sistema (no se guardan en el repositorio).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api"
    },
    {
      "key": "usuario",
      "value": ""
    },
    {
      "key": "contrasena",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "docPrueba",
      "value": ""
    },
    {
      "key": "idCargoPrueba",
      "value": "1"
    },
    {
      "key": "idTemporada",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Autenticación",
      "item": [
        {
          "name": "Login correcto",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"nombreUsuario\": \"{{usuario}}\",\n    \"contrasena\": \"{{contrasena}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Inicia sesión con un usuario del sistema. Guarda el token JWT en la variable token de la colección."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 200 OK', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test('Devuelve un token JWT', () => pm.expect(r.token.split('.')).to.have.lengthOf(3));",
                  "pm.test('Devuelve el rol', () => pm.expect(r.rol).to.be.a('string').and.not.empty);",
                  "pm.collectionVariables.set('token', r.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login con contraseña incorrecta",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"nombreUsuario\": \"{{usuario}}\",\n    \"contrasena\": \"ClaveIncorrecta1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('Mensaje de error', () => pm.expect(pm.response.json().error).to.eql('Usuario o contraseña incorrectos'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Acceso sin token",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/empleados",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Rechaza la petición sin token (403)', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        }
      ]
    },
