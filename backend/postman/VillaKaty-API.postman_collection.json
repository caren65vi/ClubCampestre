          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/empleados",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"numeroDocumento\": \"{{docPrueba}}\",\n    \"idTipoDocumento\": 1,\n    \"primerNombre\": \"Valentina\",\n    \"segundoNombre\": \"Sofía\",\n    \"primerApellido\": \"Herrera\",\n    \"segundoApellido\": \"Cano\",\n    \"telefono\": \"3001112233\",\n    \"indicativo\": \"+57\",\n    \"correo\": \"valentina.herrera@villakaty.com\",\n    \"idCargo\": {{idCargoPrueba}},\n    \"fechaContratacion\": \"2026-10-01\",\n    \"salario\": 1750905,\n    \"crearUsuario\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Documento único por ejecución para poder repetir las pruebas",
                  "pm.collectionVariables.set('docPrueba', '7' + Date.now().toString().slice(-9));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 200 OK', () => pm.response.to.have.status(200));",
                  "const e = pm.response.json();",
                  "pm.test('Queda activo', () => pm.expect(e.estado).to.eql('activo'));",
                  "pm.test('Guarda celular y correo', () => { pm.expect(e.telefono).to.eql('3001112233'); pm.expect(e.correo).to.include('@'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Registrar documento duplicado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
