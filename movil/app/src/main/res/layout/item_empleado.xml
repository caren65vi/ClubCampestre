<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de la lista de empleados: iniciales, nombre, cargo y área, documento y estado -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/vk_borde"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <TextView
            android:id="@+id/textoIniciales"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/fondo_avatar"
            android:gravity="center"
            android:textColor="@color/vk_dorado"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textoNombre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/vk_texto"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textoCargo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/vk_texto_suave" />

            <TextView
                android:id="@+id/textoDocumento"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/vk_texto_suave"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/textoEstado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/fondo_estado"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
